{
  "compilerOptions": {
    "target": "ES2022",
    "module": "ESNext",
    "moduleResolution": "bundler",
    "strict": true,
    "jsx": "react-jsx",
    "esModuleInterop": true,
    "skipLibCheck": true,
    "paths": {
      "@siparix/tokens": ["../tokens/src"],
      "@siparix/ui": ["../ui/src"]
    }
  },
  "include": ["app/**/*.ts", "app/**/*.tsx"]
}
