{
  "expo": {
    "name": "Siparix POS",
    "slug": "siparix-pos",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "scheme": "siparix-pos",
    "userInterfaceStyle": "light",
    "newArchEnabled": true,
    "ios": {
      "supportsTablet": false,
      "bundleIdentifier": "com.siparix.pos"
    },
    "android": {
      "adaptiveIcon": {
        "backgroundColor": "#F2F2F7"
      },
      "package": "com.siparix.pos"
    },
    "plugins": [
      "expo-router",
      "expo-blur",
      "expo-haptics"
    ],
    "experiments": {
      "typedRoutes": true
    }
  }
}
